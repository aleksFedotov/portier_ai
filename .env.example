# Gmail API (OAuth 2.0)
# JSON клиента из Google Cloud Console (OAuth 2.0 Client ID, тип Desktop)
GOOGLE_CREDENTIALS_FILE=credentials.json
# Кэш токена (создаётся автоматически после python -m portier.gmail_auth)
GOOGLE_TOKEN_FILE=data/token.json

# Опрос
CHECK_INTERVAL_SECONDS=180
BACKLOG_DAYS=7

# LLM-провайдер: openai или deepseek
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-совместимый API, доступен из РФ без VPN)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Telegram (не нужны для бэктеста)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890

# База данных
DATABASE_URL=sqlite+aiosqlite:///./data/hotel_bot.db

# Реквизиты отеля для счетов
HOTEL_NAME=Мини-отель «Пример»
HOTEL_INN=7701234567
HOTEL_DETAILS=р/с 40702810000000000001 в ПАО «Банк», БИК 044525225

# Каталог для PDF-счетов
INVOICES_DIR=data/invoices

# Веб-панель реестра компаний (LAN, без авторизации)
WEB_PORT=8080

# Сид реестра компаний (если файл существует и таблица пуста)
COMPANIES_SEED_FILE=companies.yaml
