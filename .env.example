# Gmail API (OAuth 2.0)
# JSON клиента из Google Cloud Console (OAuth 2.0 Client ID, тип Desktop)
GOOGLE_CREDENTIALS_FILE=credentials.json
# Кэш токена (создаётся автоматически после python -m portier.gmail_auth)
GOOGLE_TOKEN_FILE=data/token.json

# Опрос
CHECK_INTERVAL_SECONDS=180
BACKLOG_DAYS=7

# LLM-провайдер: openai или deepseek
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# DeepSeek (OpenAI-совместимый API, доступен из РФ без VPN)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Telegram (не нужны для бэктеста)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-1001234567890

# Отдельный чат для выставляемых счетов (тикет 06): уведомления invoice_required
# с PDF и команда /invoices. Не задан — счета идут в основной чат.
# INVOICE_CHAT_ID=-1001234567891

# Автоудаление закрытых карточек в чате счетов (тикет 18): карточка исчезает
# через столько часов после того, как нажаты обе кнопки (отправлен + оплачен).
# INVOICE_CARD_TTL_HOURS=24

# Google Calendar: напоминания о задачах-событиях в основной чат.
# "primary" — основной календарь аккаунта; лучше отдельный календарь «Задачи».
# CALENDAR_ID=primary
# CALENDAR_POLL_SECONDS=300

# Тихие часы (тикет 17): ночью уведомления не присылаются, накопившиеся письма
# обрабатываются после конца окна. Локальное время сервера, часы 0–23.
# Одинаковые значения — режим выключен.
# QUIET_HOURS_START=23
# QUIET_HOURS_END=7

# Устойчивость к замедлению Telegram (тикет 16). Прокси не обязателен,
# если на сервере поднят туннель. Форматы: http://user:pass@host:port, socks5://host:port
# TELEGRAM_PROXY=
# TELEGRAM_TIMEOUT=60
# TELEGRAM_RETRY_ATTEMPTS=4
# TELEGRAM_RETRY_BASE_DELAY=2

# База данных
DATABASE_URL=sqlite+aiosqlite:///./data/hotel_bot.db

# Реквизиты отеля для счетов (банковский блок, тикет 11)
HOTEL_NAME=ООО «Пример»
HOTEL_INN=7701234567
HOTEL_KPP=770101001
HOTEL_ADDRESS=191014, г Санкт-Петербург, ул Примерная, д.1
HOTEL_PHONE=+7 900 000 00 00
HOTEL_EMAIL=hotel@example.com
HOTEL_RS=40702810000000000001
HOTEL_BANK=Филиал «Пример» АО «Банк»
HOTEL_BIK=044525225
HOTEL_KS=30101810000000000225

# Печать и факсимиле для счетов (если файла нет — счёт рисуется без них)
INVOICE_STAMP_PATH=data/печать 2-Photoroom.png
INVOICE_SIGNATURE_PATH=data/подпись 2-Photoroom.png
INVOICE_LOGO_PATH=data/logo.jpg

# Каталог для PDF-счетов
INVOICES_DIR=data/invoices

# Веб-панель реестра компаний (LAN, без авторизации)
WEB_PORT=8080

# Сид реестра компаний (если файл существует и таблица пуста)
COMPANIES_SEED_FILE=companies.yaml
